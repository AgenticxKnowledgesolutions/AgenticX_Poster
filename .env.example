# ==============================================================================
# AgenticX Placement Poster Studio - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and customize values for your deployment environment.
# IMPORTANT: Never commit '.env' with real secrets to public repositories!

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SECURITY
# ------------------------------------------------------------------------------
# In PRODUCTION, always set DEBUG=False.
# Set DEBUG=True ONLY on your local machine for debugging.
DEBUG=False

# Cryptographically strong secret key (minimum 50 random characters).
# You can generate a new one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-this-with-a-very-long-random-secret-key-at-least-50-characters

# ------------------------------------------------------------------------------
# 2. HOSTS & DOMAINS
# ------------------------------------------------------------------------------
# Comma-separated list of hostnames/domains permitted to serve this application.
# Example for production:
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-app.onrender.com
# Example for local development:
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated list of trusted origins for CSRF protection (HTTPS URLs).
# Example:
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. SSL / HTTPS SECURITY (ENABLE IN PRODUCTION WITH SSL)
# ------------------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS (True in production)
SECURE_SSL_REDIRECT=True

# Ensure session & CSRF cookies are only transmitted over HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security duration (in seconds, 31536000 = 1 year)
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 4. DATABASE (OPTIONAL)
# ------------------------------------------------------------------------------
# By default, Django uses SQLite (db.sqlite3).
# If using PostgreSQL on Render, Railway, Supabase, or AWS RDS, supply DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:port/dbname

